{
  "name": "@app-atlas/cli",
  "version": "0.23.0",
  "description": "Understand any app - including the one your AI built. An interactive, always-accurate atlas of your application.",
  "license": "MIT",
  "author": "nhorto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhorto/App-Atlas.git"
  },
  "homepage": "https://github.com/nhorto/App-Atlas#readme",
  "bugs": "https://github.com/nhorto/App-Atlas/issues",
  "type": "module",
  "bin": {
    "app-atlas": "dist/node/cli.js"
  },
  "main": "dist/node/index.js",
  "exports": {
    ".": "./dist/node/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/__pycache__"
  ],
  "keywords": [
    "codebase",
    "visualization",
    "architecture",
    "static-analysis",
    "typescript",
    "python",
    "golang",
    "csharp",
    "dotnet",
    "rust",
    "documentation",
    "ai-agents",
    "vibe-coding",
    "mcp",
    "model-context-protocol",
    "code-map"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "atlas": "node dist/node/cli.js",
    "grammars": "node scripts/fetch-grammars.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.6",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
